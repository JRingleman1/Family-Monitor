{
  "name": "family-monitor",
  "private": true,
  "version": "1.0.0",
  "description": "Chore and good-deed screen time economy for our family, designed to sit alongside Google Family Link.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --only auth,firestore",
    "seed": "node scripts/seed.mjs",
    "deploy": "npm run build && firebase deploy",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.6.3",
    "vite": "^7.1.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  }
}
